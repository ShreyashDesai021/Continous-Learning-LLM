# Copy to .env before first launch if you want custom local credentials.
# Password variables apply only when accounts are first created.
EVOLLM_ADMIN_PASSWORD=EvoLLM-Admin-2026!
EVOLLM_EMPLOYEE_PASSWORD=EvoLLM-Employee-2026!
# lexical runs offline. bge requires requirements-ml.txt and downloaded BGE-M3.
EVOLLM_RETRIEVAL=lexical
EVOLLM_EMBEDDING_MODEL=BAAI/bge-m3
EVOLLM_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
EVOLLM_DEVICE=cpu
EVOLLM_ALLOW_DOWNLOADS=0
# Optional workspace label and default response engine.
EVOLLM_WORKSPACE_NAME=Company workspace
EVOLLM_GENERATOR=evidence
# Research documents are imported only when explicitly requested in the app.
EVOLLM_DEMO=0
